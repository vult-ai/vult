<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.vult.update-helper</string>
  <key>ProgramArguments</key>
  <array><string>/Library/PrivilegedHelperTools/ai.vult.updater/vult-update-helper</string></array>
  <key>UserName</key><string>root</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string><key>LANG</key><string>C</string></dict>
  <key>WorkingDirectory</key><string>/Library/Application Support/ai.vult.updater</string>
  <key>RunAtLoad</key><true/>
  <key>WatchPaths</key>
  <array>
    <string>/Library/Application Support/ai.vult.updater/request.json</string>
    <string>/Library/Application Support/ai.vult.updater/check.json</string>
  </array>
  <key>ExitTimeOut</key><integer>3600</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>18</integer>
  <key>StandardErrorPath</key><string>/Library/Application Support/ai.vult.updater/helper.log</string>
  <key>StandardOutPath</key><string>/Library/Application Support/ai.vult.updater/helper.log</string>
</dict>
</plist>
