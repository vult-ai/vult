#!/bin/sh
set -eu
export PATH=/usr/bin:/bin:/usr/sbin:/sbin LANG=C
umask 077
fail() { echo "Vult: $*" >&2; exit 1; }

[ "$(/usr/bin/id -u)" = 0 ] || fail "Administrator installation is required."
[ "${3:-/}" = / ] || fail "Install on the startup volume."
base="/Library/Application Support/ai.vult.ledger"
data="$base/data"
binary=/Library/PrivilegedHelperTools/ai.vult.ledger/vult

if ! /usr/bin/dscl . -read /Users/_vultledger >/dev/null 2>&1; then
    selected=
    number=400
    while [ "$number" -lt 500 ]; do
        if ! /usr/bin/dscl . -list /Users UniqueID | /usr/bin/awk '{print $2}' | /usr/bin/grep -qx "$number" &&
           ! /usr/bin/dscl . -list /Groups PrimaryGroupID | /usr/bin/awk '{print $2}' | /usr/bin/grep -qx "$number"; then
            selected=$number
            break
        fi
        number=$((number + 1))
    done
    [ -n "$selected" ] || fail "No unused service identity is available."
    /usr/bin/dscl . -create /Groups/_vultledger
    /usr/bin/dscl . -create /Groups/_vultledger PrimaryGroupID "$selected"
    /usr/bin/dscl . -create /Groups/_vultledger Password '*'
    /usr/bin/dscl . -create /Users/_vultledger
    /usr/bin/dscl . -create /Users/_vultledger UniqueID "$selected"
    /usr/bin/dscl . -create /Users/_vultledger PrimaryGroupID "$selected"
    /usr/bin/dscl . -create /Users/_vultledger RealName 'Vult Ledger'
    /usr/bin/dscl . -create /Users/_vultledger NFSHomeDirectory /var/empty
    /usr/bin/dscl . -create /Users/_vultledger UserShell /usr/bin/false
    /usr/bin/dscl . -create /Users/_vultledger Password '*'
    /usr/bin/dscl . -create /Users/_vultledger IsHidden 1
    /usr/sbin/dseditgroup -o edit -a _vultledger -t user _vultledger
fi
uid=$(/usr/bin/dscl . -read /Users/_vultledger UniqueID | /usr/bin/awk '{print $2}')
gid=$(/usr/bin/dscl . -read /Users/_vultledger PrimaryGroupID | /usr/bin/awk '{print $2}')
[ "$uid" -gt 0 ] && [ "$gid" -gt 0 ] || fail "Invalid dedicated service identity."

/bin/mkdir -p "$base"
/usr/sbin/chown root:wheel "$base"
/bin/chmod -N "$base"
/bin/chmod 0755 "$base"
if ! /usr/bin/dscl . -read /Users/_vultbrowser >/dev/null 2>&1; then
    selected=
    number=400
    while [ "$number" -lt 500 ]; do
        if ! /usr/bin/dscl . -list /Users UniqueID | /usr/bin/awk '{print $2}' | /usr/bin/grep -qx "$number" &&
           ! /usr/bin/dscl . -list /Groups PrimaryGroupID | /usr/bin/awk '{print $2}' | /usr/bin/grep -qx "$number"; then
            selected=$number
            break
        fi
        number=$((number + 1))
    done
    [ -n "$selected" ] || fail "No unused browser identity is available."
    /usr/bin/dscl . -create /Groups/_vultbrowser
    /usr/bin/dscl . -create /Groups/_vultbrowser PrimaryGroupID "$selected"
    /usr/bin/dscl . -create /Groups/_vultbrowser Password '*'
    /usr/bin/dscl . -create /Users/_vultbrowser
    /usr/bin/dscl . -create /Users/_vultbrowser UniqueID "$selected"
    /usr/bin/dscl . -create /Users/_vultbrowser PrimaryGroupID "$selected"
    /usr/bin/dscl . -create /Users/_vultbrowser RealName 'Vult Browser'
    /usr/bin/dscl . -create /Users/_vultbrowser NFSHomeDirectory /var/empty
    /usr/bin/dscl . -create /Users/_vultbrowser UserShell /usr/bin/false
    /usr/bin/dscl . -create /Users/_vultbrowser Password '*'
    /usr/bin/dscl . -create /Users/_vultbrowser IsHidden 1
fi
browser_uid=$(/usr/bin/dscl . -read /Users/_vultbrowser UniqueID | /usr/bin/awk '{print $2}')
browser_gid=$(/usr/bin/dscl . -read /Users/_vultbrowser PrimaryGroupID | /usr/bin/awk '{print $2}')
[ "$browser_uid" -gt 0 ] && [ "$browser_gid" -gt 0 ] && [ "$browser_uid" != "$uid" ] || fail "The browser identity must be separate from the ledger."
/usr/sbin/dseditgroup -o edit -a _vultbrowser -t user _vultbrowser
/usr/sbin/dseditgroup -o edit -a _vultledger -t user _vultbrowser
if [ ! -e "$base/browser-installation" ]; then
    /usr/bin/printf 'vult-browser-v1 %s %s\n' "$browser_uid" "$browser_gid" > "$base/browser-installation"
    /usr/sbin/chown root:wheel "$base/browser-installation"
    /bin/chmod 0644 "$base/browser-installation"
fi
for path in "$base/browser" "$base/postgres"; do
    owner=0
    [ "$path" != "$base/postgres" ] || owner=$uid
    [ ! -L "$path" ] || fail "A browser service directory is a symbolic link."
    if [ -e "$path" ]; then
        [ -d "$path" ] && [ "$(/usr/bin/stat -f %u "$path")" = "$owner" ] && [ "$(/usr/bin/stat -f %g "$path")" = "$browser_gid" ] || fail "A browser service directory has an unexpected owner."
    else
        /bin/mkdir "$path"
        /usr/sbin/chown "$owner:$browser_gid" "$path"
    fi
    /bin/chmod -N "$path"
    /bin/chmod 0750 "$path"
done
if [ ! -e "$base/installation" ]; then
    /usr/bin/printf 'vult-service-v1 %s %s\n' "$uid" "$gid" > "$base/installation"
    /usr/sbin/chown root:wheel "$base/installation"
    /bin/chmod 0644 "$base/installation"
fi

for path in "$data" "$base/socket"; do
    [ ! -L "$path" ] || fail "A private service directory is a symbolic link."
    if [ -e "$path" ]; then
        [ -d "$path" ] && [ "$(/usr/bin/stat -f %u "$path")" = "$uid" ] || fail "A private service directory has an unexpected owner."
    else
        /bin/mkdir "$path"
        /usr/sbin/chown "$uid:$gid" "$path"
    fi
    /bin/chmod -N "$path"
done
/bin/chmod 0700 "$data"
/bin/chmod 0755 "$base/socket"
"$binary" _install
# Create or update the database here, while the service is stopped. The
# service itself only checks the schema when it starts.
/usr/bin/sudo -u _vultledger "$binary" _maintenance migrate >/dev/null || fail "The database update did not complete. Stored Books were preserved and nothing was changed."

# Install a shell shortcut only into protected directories, never over a command.
safe_shortcut=yes
for path in /usr /usr/local /usr/local/bin; do
    if [ ! -d "$path" ] || [ -L "$path" ]; then safe_shortcut=no; break; fi
    if [ "$(/usr/bin/stat -f %u "$path")" != 0 ]; then safe_shortcut=no; fi
    mode=$(/usr/bin/stat -f %Lp "$path")
    if [ $((0$mode & 0022)) -ne 0 ]; then safe_shortcut=no; fi
    if /bin/ls -lde "$path" | /usr/bin/tail -n +2 | /usr/bin/grep -q ' allow '; then safe_shortcut=no; fi
done
if [ "$safe_shortcut" = yes ] && [ ! -e /usr/local/bin/vult ] && [ ! -L /usr/local/bin/vult ]; then
    /bin/ln -s "$binary" /usr/local/bin/vult
fi

# The update installer, when this package carries it: the app's Update
# button writes a request, and this root job installs the newest release
# both signatures agree on.
updater=/Library/PrivilegedHelperTools/ai.vult.updater
ustate="/Library/Application Support/ai.vult.updater"
if [ -f "$updater/vult-update-helper" ] && [ ! -L "$updater/vult-update-helper" ]; then
    for path in "$ustate" "$ustate/trust" "$ustate/journal"; do
        [ ! -L "$path" ] || fail "An update directory is a symbolic link."
        /bin/mkdir -p "$path"
        /usr/sbin/chown root:wheel "$path"
        /bin/chmod -N "$path"
        /bin/chmod 0755 "$path"
    done
    for path in "$ustate/trust/metadata" "$ustate/staging" "$ustate/copies"; do
        [ ! -L "$path" ] || fail "An update directory is a symbolic link."
        /bin/mkdir -p "$path"
        /usr/sbin/chown root:wheel "$path"
        /bin/chmod -N "$path"
        /bin/chmod 0700 "$path"
    done
    # The owner's request, written by the app (which runs as the browser
    # account) and read by the installer as untrusted input.
    for request in "$ustate/request.json" "$ustate/check.json"; do
        [ ! -L "$request" ] || fail "The update request file is a symbolic link."
        [ -e "$request" ] || : > "$request"
        [ -f "$request" ] || fail "The update request file is not a plain file."
        /usr/sbin/chown "$browser_uid:$browser_gid" "$request"
        /bin/chmod 0644 "$request"
    done
    # This package is what is installed now.
    report=$(/usr/bin/sudo -u _vultledger "$binary" _maintenance validate) || fail "The installed database could not be checked."
    schema=$(/usr/bin/printf '%s' "$report" | /usr/bin/plutil -extract schema raw -o - -) || fail "The installed schema is unknown."
    installed_version=$("$binary" --version | /usr/bin/awk '{print $2}')
    /usr/bin/printf '{"version":"%s","sha256":"package","schema":"%s"}\n' "$installed_version" "$schema" > "$ustate/installed.json.tmp"
    /usr/sbin/chown root:wheel "$ustate/installed.json.tmp"
    /bin/chmod 0644 "$ustate/installed.json.tmp"
    /bin/mv -f "$ustate/installed.json.tmp" "$ustate/installed.json"
    if /bin/launchctl print system/ai.vult.update-helper >/dev/null 2>&1; then
        /bin/launchctl bootout system/ai.vult.update-helper || true
    fi
    /bin/launchctl bootstrap system /Library/LaunchDaemons/ai.vult.update-helper.plist
fi

/bin/launchctl bootstrap system /Library/LaunchDaemons/ai.vult.ledger.plist
/bin/launchctl kickstart system/ai.vult.ledger
attempt=0
while [ "$attempt" -lt 30 ]; do
    if "$binary" status >/dev/null 2>&1; then
        "$binary" _browser_install || fail "Local browser setup failed; stored Books were preserved."
        /bin/launchctl bootstrap system /Library/LaunchDaemons/ai.vult.browser.plist
        /bin/launchctl kickstart system/ai.vult.browser
        "$binary" _browser_check || fail "The local browser did not become ready. Stored Books were preserved; inspect the browser service log."
        echo "Vult installed. Next: $binary mcp install, then $binary setup."
        exit 0
    fi
    attempt=$((attempt + 1))
    /bin/sleep 1
done
fail "The ledger did not become ready. Stored data was not reinitialized; inspect the service log."
