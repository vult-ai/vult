<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.vult.browser</string>
  <key>ProgramArguments</key>
  <array><string>/Library/PrivilegedHelperTools/ai.vult.ledger/vult</string><string>_serve_browser</string></array>
  <key>UserName</key><string>_vultbrowser</string>
  <key>GroupName</key><string>_vultbrowser</string>
  <key>InitGroups</key><false/>
  <key>WorkingDirectory</key><string>/Library/Application Support/ai.vult.ledger/browser</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string><key>LANG</key><string>C</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ExitTimeOut</key><integer>15</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>SoftResourceLimits</key>
  <dict><key>NumberOfFiles</key><integer>512</integer><key>Core</key><integer>0</integer></dict>
  <key>StandardErrorPath</key><string>/Library/Application Support/ai.vult.ledger/browser.log</string>
  <key>StandardOutPath</key><string>/dev/null</string>
</dict>
</plist>
